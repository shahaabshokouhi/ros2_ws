<!--
  NavigateToPose for a car (front-wheel steering) that sees obstacles only
  within ~1 m and treats unseen space as free.

  Replans only when the goal changes or the current path becomes blocked
  (checked 3 times a second, so a newly seen obstacle triggers a new path
  quickly). Re-running Hybrid-A* every second from a slightly different pose
  picked a different manoeuvre each time.

  Recoveries back up, then wait. They never clear the costmaps: with a 1 m
  sensor and unknown = free, clearing made the robot forget an obstacle it
  could no longer see from up close and plan straight into it again
  (simulation, 2026-10-10). No Spin: a car cannot turn on the spot.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="3.0">
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <IsPathValid path="{path}"/>
            </ReactiveSequence>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <BackUp backup_dist="0.25" backup_speed="0.08"/>
          <Wait wait_duration="2"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
