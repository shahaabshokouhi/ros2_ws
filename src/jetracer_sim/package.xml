<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetracer_sim</name>
  <version>0.1.0</version>
  <description>Isaac Sim stand-in for one JetRacer: runs the robot's SLAM, grid and Nav2 stack against a simulated car with ground truth</description>
  <maintainer email="shokohishahab@gmail.com">Shahab Shokouhi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>orb_slam3</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
