Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid (1 m)
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Occupancy grid
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: false
      Topic:
        Value: /__AGENT__/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Update Topic:
        Value: /__AGENT__/map_updates
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: ORB-SLAM3 map points
      Topic:
        Value: /__AGENT__/orb_slam3/merged_map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Value: false
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Robot (odom)
      Keep: 1
      Topic:
        Value: /__AGENT__/orb_slam3/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Shaft Length: 0.25
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trajectory
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /__AGENT__/orb_slam3/path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera (gray)
      Topic:
        Value: /__AGENT__/orb_slam3/gray
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        base_link:
          Value: true
        map_nav:
          Value: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map_nav
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 120
      X: 0
      Y: 0
      Angle: 0
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
Window Geometry:
  Height: 900
  Width: 1400
